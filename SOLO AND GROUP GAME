            divineInterventions.forEach(item => { diHtml += `<div><strong>${item.label}:</strong> ${item.q}</div><div class="ms-ans" style="color:#8e44ad;">Ans: ${item.ans}</div><br>`; });
            diHtml += `</div><div class="ms-category" style="border-left-color: #009688;"><h3 style="color: #009688; margin-top:0;">👥 Audience Riddles</h3>`;
            audienceIntermissions.forEach(item => { diHtml += `<div><strong>Riddle:</strong> ${item.q}</div><div class="ms-ans" style="color:#009688;">Ans: ${item.ans}</div><br>`; });
            diHtml += '</div>';
            content.innerHTML = diHtml;
        } else {
            let html = `<div class="ms-category"><h3 style="margin-top:0;">${cat}</h3>`;
            gameData[cat].forEach((item, idx) => { html += `<div><strong>${idx + 1}. ${item.q}</strong></div><div class="ms-ans">Answer Key: Option ${item.ans}</div><br>`; });
            html += '</div>';
            content.innerHTML = html;
        }
    }

    function rollBlitzChance() {
        if(!nextCategoryBlitz) {
            if(Math.random() < 0.20) {
                nextCategoryBlitz = true; show('blitz-warning-banner');
            } else { hide('blitz-warning-banner'); }
        }
    }

    function toggleCategoryState(catName) {
        playClick();
        if(categoryWinners[catName]) {
            delete categoryWinners[catName];
        } else {
            categoryWinners[catName] = "Manually Closed";
        }
        renderCategories();
    }

    function renderCategories() {
        const grid = el('categories-grid'); grid.innerHTML = '';
        for (const cat in gameData) {
            const card = document.createElement('div');
            card.id = `card-${cat.replace(/[^a-zA-Z0-9]/g, "")}`;
            const completed = categoryWinners[cat];
            card.className = `category-card ${completed ? 'completed' : ''}`;

            const descText = gameMetadata[cat] || "";
            let innerHTML = `<h3 class="category-title">${cat}</h3><span class="category-desc">${descText}</span>`;

            if(completed) {
                innerHTML += `<div><span class="winner-badge">Winner: ${categoryWinners[cat]}</span>`;
                innerHTML += `<br><button class="btn-pu" style="margin-top: 10px;" onclick="event.stopPropagation(); toggleCategoryState('${cat}')">🔄 Re-open / Reset</button></div>`;
            } else {
                innerHTML += `<div><button class="btn-pu" style="margin-top: 10px; opacity: 0.5;" onclick="event.stopPropagation(); toggleCategoryState('${cat}')">🔒 Close Category</button></div>`;
            }

            card.innerHTML = innerHTML;

            card.onclick = () => {
                if(!completed) { playClick(); openCategory(cat); }
            };

            grid.appendChild(card);
        }
    }

    function startRandomizer() {
        const available = Object.keys(gameData).filter(c => !categoryWinners[c]);
        if (!available.length) return alert("Lahat ng categories ay tapos o sarado na!");

        el('btn-randomize').disabled = true;
        el('categories-grid').scrollIntoView({ behavior: 'smooth', block: 'center' });
        const grid = el('categories-grid'); grid.classList.add('randomizing-active');

        let spins = 30, currentIdx = Math.floor(Math.random() * available.length), delay = 40;
        function spin() {
            document.querySelectorAll('.category-card').forEach(c => c.classList.remove('random-highlight'));
            currentIdx = Math.floor(Math.random() * available.length);
            const cat = available[currentIdx];
            const card = el(`card-${cat.replace(/[^a-zA-Z0-9]/g, "")}`);
            if(card) card.classList.add('random-highlight');
            playBloop(currentIdx);

            if (spins > 0) {
                spins--; delay += 10; setTimeout(spin, delay);
            } else {
                el('btn-randomize').disabled = false; selectedRandomCategory = available[currentIdx];
                setTimeout(() => { grid.classList.remove('randomizing-active'); triggerAnnouncementPopup(selectedRandomCategory); }, 850);
            }
        }
        spin();
    }

    function triggerAnnouncementPopup(catName) {
        el('main-popup-card').className = "popup-card";
        el('popup-dynamic-injection-zone').innerHTML = "";
        el('popup-badge-label').textContent = "Target Chosen"; el('popup-badge-label').style.background = "var(--primary)";
        el('popup-cat-title').textContent = catName;
        el('popup-cat-desc').style.display = "block"; el('popup-cat-desc').textContent = gameMetadata[catName] || "";

        show('popup-standard-actions'); hide('popup-intervention-actions'); hide('popup-scoreboard-actions'); hide('popup-finalboss-actions');
        show('announcement-popup');
    }

    function triggerDivineIntervention() {
        playClick(); el('main-popup-card').className = "popup-card intervention-mode";
        el('popup-badge-label').textContent = "⚡ DIVINE INTERVENTION"; el('popup-cat-title').textContent = "Pumili ng Inyong Destiny";
        el('popup-cat-desc').style.display = "none";
        el('popup-dynamic-injection-zone').innerHTML = `
      <div id="di-initial-choice-view">
        <p style="color: #dcdde1; font-weight: 500; font-size: 0.95rem; margin-bottom: 20px;">Pumili ng isa nang bulag. High risk, high reward ito!</p>
        <div class="di-choice-grid">
          <button class="btn-di-choice" onclick="selectDivineBonus(0)">🎁 Choice A</button>
          <button class="btn-di-choice" onclick="selectDivineBonus(1)">🎁 Choice B</button>
        </div>
      </div>
      <div class="intervention-scroll-box hidden" id="divine-live-scroll-box"></div>
    `;
        hide('popup-standard-actions'); hide('popup-scoreboard-actions'); hide('popup-finalboss-actions'); show('popup-intervention-actions');
        el('btn-reveal-ans').style.display = "none";
        show('announcement-popup');
    }

    function selectDivineBonus(index) {
        playClick();
        const bonus = divineInterventions[index];
        hide('di-initial-choice-view');

        const scrollBox = el('divine-live-scroll-box');
        scrollBox.innerHTML = `
      <span class="popup-badge" style="background:#be2edd; color:white; font-size: 0.75rem;">🔥 MAY HALONG 10 POINTS ANG TANONG NA ITO</span>
      <div class="intervention-question-text">${bonus.q}</div>
      <div id='di-reveal-box' class='answer-panel hidden' style='margin: 15px auto 0 auto; background: #fff176; color: #1e272e;'>
        Tamang Sagot: ${bonus.ans}
      </div>
    `;
        scrollBox.classList.remove('hidden');

        el('btn-reveal-ans').style.display = "block";
        el('btn-reveal-ans').onclick = function() {
            playDing(); show('di-reveal-box'); el('btn-reveal-ans').style.display = "none";

            let teamHtml = `<div style="margin-top:20px; text-align:left; border-top: 1px solid rgba(0,0,0,0.1); padding-top:15px;">
        <p style="color:#b33939; margin-bottom:10px; font-weight:bold; font-size:0.9rem; text-transform:uppercase;">I-click ang nakasagot para sa +10 Points:</p>
        <div style="display:flex; flex-wrap:wrap; gap:10px;">`;
            teams.forEach((t, i) => {
                teamHtml += `<button class="btn-secondary btn-di-team" style="border:none; background:#8e44ad; color:white; font-size:0.9rem;" onclick="awardBonusPoints(${i}, 10, this)">🏆 ${t.name}</button>`;
            });
            teamHtml += `</div></div>`;
            el('di-reveal-box').innerHTML += teamHtml;
        };
    }

    function triggerAudienceIntermission() {
        playClick(); el('main-popup-card').className = "popup-card audience-mode";
        el('popup-badge-label').textContent = "👥 AUDIENCE BREAK"; el('popup-badge-label').style.background = "#009688";
        el('popup-cat-title').textContent = "Tanong Para sa Crowd!"; el('popup-cat-desc').style.display = "none";

        el('popup-dynamic-injection-zone').innerHTML = `
      <div id="aud-initial-choice-view">
        <p style="color: var(--text-muted); font-weight: 500; margin-bottom: 20px;">Pumili ng isa sa mga riddles:</p>
        <div class="di-choice-grid" style="grid-template-columns: 1fr 1fr 1fr;">
          <button class="btn-di-choice" style="background:#009688; border-color:#00796b; padding:10px;" onclick="selectAudienceRiddle(0)">❓ Riddle 1</button>
          <button class="btn-di-choice" style="background:#009688; border-color:#00796b; padding:10px;" onclick="selectAudienceRiddle(1)">❓ Riddle 2</button>
          <button class="btn-di-choice" style="background:#009688; border-color:#00796b; padding:10px;" onclick="selectAudienceRiddle(2)">❓ Riddle 3</button>
        </div>
      </div>
      <div class="audience-scroll-box hidden" id="aud-live-scroll-box"></div>
    `;

        hide('popup-standard-actions'); hide('popup-scoreboard-actions'); hide('popup-finalboss-actions'); show('popup-intervention-actions');
        el('btn-reveal-ans').style.display = "none";
        show('announcement-popup');
    }

    function selectAudienceRiddle(index) {
        playClick();
        const riddle = audienceIntermissions[index];
        hide('aud-initial-choice-view');

        const scrollBox = el('aud-live-scroll-box');
        scrollBox.innerHTML = `
      <span class="popup-badge" style="background:#009688; color:white; font-size:0.75rem;">Kahit sino sa nakaupo pwedeng sumagot (+10 Pts)</span>
      <div class="audience-question-text">${riddle.q}</div>
      <div id='aud-reveal-box' class='answer-panel hidden' style='margin: 15px auto 0 auto; background: #fff176; color: #1e272e;'>
        Tamang Sagot: ${riddle.ans}
      </div>
    `;
        scrollBox.classList.remove('hidden');

        el('btn-reveal-ans').style.display = "block";
        el('btn-reveal-ans').onclick = function() {
            playDing(); show('aud-reveal-box'); el('btn-reveal-ans').style.display = "none";

            let teamHtml = `<div style="margin-top:20px; text-align:left; border-top: 1px solid rgba(0,0,0,0.1); padding-top:15px;">
        <p style="color:#009688; margin-bottom:10px; font-weight:bold; font-size:0.9rem; text-transform:uppercase;">I-click ang team ng nakasagot para sa +10 Points:</p>
        <div style="display:flex; flex-wrap:wrap; gap:10px;">`;
            teams.forEach((t, i) => {
                teamHtml += `<button class="btn-secondary btn-di-team" style="border:none; background:#009688; color:white; font-size:0.9rem;" onclick="awardBonusPoints(${i}, 10, this)">🏆 ${t.name}</button>`;
            });
            teamHtml += `</div></div>`;
            el('aud-reveal-box').innerHTML += teamHtml;
        };
    }

    function awardBonusPoints(idx, pts, btnObj) {
        teams[idx].score += pts;
        document.querySelectorAll('.btn-di-team').forEach(b => { b.disabled = true; b.style.opacity = '0.4'; });
        btnObj.style.opacity = '1'; btnObj.textContent = `✔️ Awarded to ${teams[idx].name}`; btnObj.style.background = "#27ae60";
        alert(`🎉 ${pts} Points successfully added to ${teams[idx].name}! New Score: ${teams[idx].score}`);
    }

    function triggerFinalBoss() {
        el('main-popup-card').className = "popup-card";
        el('popup-badge-label').textContent = "💀 ALL OR NOTHING"; el('popup-badge-label').style.background = "#c0392b";
        el('popup-cat-title').textContent = "Final Wager Round"; el('popup-cat-desc').style.display = "block";
        el('popup-cat-desc').textContent = "GM, ilagay ang taya ng bawat team bago ipakita ang tanong.";

        let wagerHtml = `<div class="wager-grid">`;
        teams.forEach((t, idx) => { wagerHtml += `<div class="wager-row"><label>${t.name} (Pts: ${t.score})</label><input type="number" id="wager-input-${idx}" min="0" max="${t.score}" placeholder="Taya..."></div>`; });
        wagerHtml += `</div>`;
        el('popup-dynamic-injection-zone').innerHTML = wagerHtml;

        hide('popup-standard-actions'); hide('popup-intervention-actions'); hide('popup-scoreboard-actions'); show('popup-finalboss-actions');
        show('announcement-popup');
    }

    function startFinalBossQuestion() {
        playSiren(); el('popup-cat-desc').style.display = "none";
        let html = `<div class="audience-scroll-box" style="border-color:#c0392b;">
      <div class="audience-question-text" style="color:#c0392b;">${finalBossData.q}</div>
      <div id='fb-reveal-box' class='answer-panel hidden'>Answer: ${finalBossData.ans}</div>
    </div><div style="text-align:left; margin-top:20px;">`;

        teams.forEach((t, idx) => {
            let w = parseInt(el(`wager-input-${idx}`).value) || 0;
            html += `<div style="display:flex; justify-content:space-between; margin-bottom:10px; align-items:center; background:#f1f5f9; padding:12px; border-radius:8px; color:var(--text-main);">
        <strong style="font-size:1.05rem;">${t.name} <br><span style="color:var(--text-muted); font-size:0.85rem;">(Taya: ${w})</span></strong>
        <div style="display:flex; gap:8px;">
          <button class="btn-pu btn-fb-${idx}" style="background:#22c55e; color:white; border:none; padding:8px 15px; font-size:0.9rem;" onclick="applyWager(${idx}, ${w}, 1)">🏆 Win (+${w})</button>
          <button class="btn-pu btn-fb-${idx}" style="background:#ef4444; color:white; border:none; padding:8px 15px; font-size:0.9rem;" onclick="applyWager(${idx}, ${w}, -1)">❌ Lose (-${w})</button>
        </div>
      </div>`;
        });
        html += `</div>`;
        el('popup-dynamic-injection-zone').innerHTML = html;

        hide('popup-finalboss-actions'); show('popup-intervention-actions');

        el('btn-reveal-ans').style.display = "block";
        el('btn-reveal-ans').onclick = function() {
            playDing(); show('fb-reveal-box'); el('btn-reveal-ans').style.display = "none";
        };
    }

    function applyWager(idx, amt, mult) {
        teams[idx].score += (amt * mult);
        if(mult > 0) playClick();

        document.querySelectorAll(`.btn-fb-${idx}`).forEach(b => { b.disabled = true; b.style.opacity = "0.4"; });
        alert(`Taya na ${amt} ay ${mult > 0 ? 'NAIDAGDAG sa' : 'BINAWAS sa'} ${teams[idx].name}! New Score: ${teams[idx].score}`);
    }

    function closeInterventionPopup() { playClick(); hide('announcement-popup'); el('popup-dynamic-injection-zone').innerHTML = ""; document.querySelectorAll('.category-card').forEach(c => c.classList.remove('random-highlight')); }

    function openScoreboardPopup() {
        playClick(); el('main-popup-card').className = "popup-card";
        el('popup-badge-label').textContent = "Standings Board"; el('popup-badge-label').style.background = "var(--success)";
        el('popup-cat-title').textContent = "🏆 Kasalukuyang Ranking"; el('popup-cat-desc').style.display = "none";

        renderScoreboardPopupHTML();

        hide('popup-standard-actions'); hide('popup-intervention-actions'); hide('popup-finalboss-actions'); show('popup-scoreboard-actions'); show('announcement-popup');
    }

    function renderScoreboardPopupHTML() {
        let scoreRowsHtml = `<table class="scoreboard-table"><thead><tr><th>Ministry / Team</th><th>Score</th><th>Edit</th></tr></thead><tbody>`;
        let mappedTeams = teams.map((t, idx) => ({...t, origIdx: idx}));
        mappedTeams.sort((a,b) => b.score - a.score).forEach(t => {
            scoreRowsHtml += `<tr>
        <td><strong>${t.name}</strong></td>
        <td class="score-number">${t.score}</td>
        <td>
          <button class="sb-edit-btn" onclick="adjPopScore(${t.origIdx}, 1)">+</button>
          <button class="sb-edit-btn" onclick="adjPopScore(${t.origIdx}, -1)">-</button>
        </td>
      </tr>`;
        });
        scoreRowsHtml += `</tbody></table>`;
        el('popup-dynamic-injection-zone').innerHTML = scoreRowsHtml;
    }

    function adjPopScore(idx, amt) {
        teams[idx].score = Math.max(0, teams[idx].score + amt);
        renderScoreboardPopupHTML();
    }

    function closeScoreboardPopup() { playClick(); hide('announcement-popup'); el('popup-dynamic-injection-zone').innerHTML = ""; }
    function triggerReSpin() { playClick(); hide('announcement-popup'); startRandomizer(); }
    function closeAnnouncementPopup(launchCategory) {
        playClick(); hide('announcement-popup');
        if(launchCategory && selectedRandomCategory) openCategory(selectedRandomCategory);
        else document.querySelectorAll('.category-card').forEach(c => c.classList.remove('random-highlight'));
        selectedRandomCategory = "";
    }

    function openCategory(catName) {
        activeCategory = catName;
        activeQuestionIndex = 0;
        activeQuestionAnswered = false;
        categoryStartScores = teams.map(t => t.score);

        if(nextCategoryBlitz) {
            activeModifiers.speed = true;
            el('mod-speed').className = `mod-pill active-speed`;
            el('mod-speed').textContent = `⚡ 7s Speed Blitz: ON`;
            nextCategoryBlitz = false;
            hide('blitz-warning-banner');
        }

        switchTab('board');
        renderQuestionSlide();
        renderEmbeddedScoringDashboard();
    }

    function initBlitzTimer() {
        clearBlitzInterval();
        if (!activeModifiers.speed) { hide('blitz-timer-container'); document.body.classList.remove('intense-blitz-active'); return; }
        document.body.classList.add('intense-blitz-active'); blitzTimeLeft = 7; show('blitz-timer-container'); updateBlitzTimerUI();

        blitzInterval = setInterval(() => {
            blitzTimeLeft--; updateBlitzTimerUI();
            if (blitzTimeLeft <= 0) {
                clearBlitzInterval(); playBuzzer();
                if (activeQuestionIndex < gameData[activeCategory].length - 1) {
                    alert("⏳ TIME'S UP! Walang nakasagot sa loob ng 7 segundo. Lipat na sa susunod na slide!"); changeQuestionSlide(1);
                } else {
                    alert("⏳ TIME'S UP sa huling tanong! I-click ang green button para matapos ang category."); activeQuestionAnswered = true; renderQuestionSlide();
                }
            }
        }, 1000);
    }

    function clearBlitzInterval() { if (blitzInterval) { clearInterval(blitzInterval); blitzInterval = null; } document.body.classList.remove('intense-blitz-active'); }
    function updateBlitzTimerUI() { el('blitz-live-bar').style.width = `${(blitzTimeLeft / 7) * 100}%`; el('blitz-live-text').textContent = `REMAINING BLITZ TIME: ${blitzTimeLeft}s`; }

    function renderQuestionSlide() {
        const items = gameData[activeCategory], total = items.length, item = items[activeQuestionIndex];
        el('question-progress-label').textContent = `Tanong ${activeQuestionIndex + 1} mula sa ${total}`;

        const noticeContainer = el('live-modifier-notice-container'); noticeContainer.innerHTML = "";
        if(activeModifiers.silent) noticeContainer.innerHTML += `<div class="live-modifier-notice">🤫 SILENT DISCIPLE RULE ACTIVE: Bawal bumulong o magsalita! Sign language at sulat-kamay lang ang pwede!</div>`;
        if(activeModifiers.speed) noticeContainer.innerHTML += `<div class="live-modifier-notice" style="background:#fec2c2; color:#991b1b; border-left-color:#ef4444;">⚡ SPEED BLITZ RUNNING: Mabilisang pagsagot, 7 segundo lamang!</div>`;

        let optionsHtml = '<div class="options-grid">';
        const letters = ['A', 'B', 'C', 'D'];
        item.options.forEach((opt, i) => { optionsHtml += `<div class="option-item" id="opt-btn-${letters[i]}" onclick="evaluateChoice('${letters[i]}')"><strong>${letters[i]})</strong> ${opt}</div>`; });
        optionsHtml += '</div>';

        el('question-body-area').innerHTML = `<div class="q-text">${item.q}</div> ${optionsHtml}<div id="slide-answer-box" class="answer-panel ${activeQuestionAnswered ? '' : 'hidden'}">Verified System Answer: Option ${item.ans}</div>`;
        el('btn-prev-slide').disabled = (activeQuestionIndex === 0); el('btn-next-slide').disabled = (activeQuestionIndex === total - 1);

        const actionBtn = el('btn-action-slide');
        actionBtn.textContent = activeQuestionAnswered ? "Itago ang Sagot" : "Ipakita ang Sagot";
        actionBtn.style.background = activeQuestionAnswered ? "var(--text-muted)" : "var(--primary)";
        el('btn-finalize-cat').style.display = (activeQuestionIndex === total - 1 && activeQuestionAnswered) ? "block" : "none";

        if (!activeQuestionAnswered) initBlitzTimer();
        else { hide('blitz-timer-container'); document.body.classList.remove('intense-blitz-active'); }
    }

    function evaluateChoice(letter) {
        const correctLetter = gameData[activeCategory][activeQuestionIndex].ans;
        const targetElement = el(`opt-btn-${letter}`);

        if (letter === correctLetter) {
            clearBlitzInterval(); hide('blitz-timer-container'); targetElement.classList.add('correct'); activeQuestionAnswered = true; show('slide-answer-box');
            if(activeQuestionIndex === gameData[activeCategory].length - 1) el('btn-finalize-cat').style.display = "block";
        } else {
            targetElement.classList.add('wrong');
            playBuzzer();
        }
    }

    function handleSlideAction() { activeQuestionAnswered = !activeQuestionAnswered; if(activeQuestionAnswered) { clearBlitzInterval(); hide('blitz-timer-container'); } renderQuestionSlide(); }
    function changeQuestionSlide(dir) { clearBlitzInterval(); activeQuestionIndex += dir; activeQuestionAnswered = false; renderQuestionSlide(); }

    function renderEmbeddedScoringDashboard() {
        const container = el('embedded-scoring-rows'); container.innerHTML = '';
        teams.forEach((team, idx) => {
            container.innerHTML += `
        <div class="scoring-row">
          <div class="team-info">
            <span class="team-identity">${team.name}</span>
          </div>
          <div class="actions-cluster">
            <button class="btn-adjustment btn-dec" onclick="adjustScore(${idx}, -1)">-</button>
            <span class="current-val" id="embed-s-${idx}">${team.score}</span>
            <button class="btn-adjustment btn-inc" onclick="adjustScore(${idx}, 1)">+</button>
          </div>
        </div>`;
        });
    }

    function adjustScore(idx, amt) {
        teams[idx].score = Math.max(0, teams[idx].score + amt);
        el(`embed-s-${idx}`).textContent = teams[idx].score;
    }

    function finalizeCategorySession() {
        clearBlitzInterval();

        let diffs = teams.map((t, i) => t.score - categoryStartScores[i]);
        let maxDiff = Math.max(...diffs);
        let winners = [];
        if (maxDiff > 0) {
            teams.forEach((t, i) => { if(diffs[i] === maxDiff) winners.push(t.name); });
            categoryWinners[activeCategory] = winners.join(", ");
        } else {
            categoryWinners[activeCategory] = "No Winner";
        }

        activeCategory = "";
        backToCategoriesFromQuestions();
    }

    function backToCategoriesFromQuestions() { clearBlitzInterval(); activeCategory = ""; hide('questions-view'); switchTab('board'); }
</script>
</body>
</html>
