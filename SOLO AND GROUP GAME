    function ansTrivia(sel, isTimeout = false) {
        if(isTimeout) {
            evalAndProceed(sel, false);
            return;
        }

        const isCorrect = sel === soloGameData[activeCat][qIndex].ans;
        const btn = el(`opt-${sel}`);

        if (isCorrect) {
            btn.style.background = '#10b981';
            evalAndProceed(sel, true);
        } else {
            qChances--;
            btn.style.background = '#ef4444';
            btn.disabled = true;

            if (qChances > 0) {
                el('solo-q-chances').innerHTML = "❤️🖤";
            } else {
                el('solo-q-chances').innerHTML = "🖤🖤";
                evalAndProceed(sel, false);
            }
        }
    }

    function evalAndProceed(sel, isCorrect) {
        clearInterval(tInt);
        document.querySelectorAll('.solo-opt-btn').forEach(b => b.disabled = true);

        if(!isCorrect) el(`opt-${soloGameData[activeCat][qIndex].ans}`).style.background = '#10b981';

        let pts = isCorrect ? 100 + (tTime*10) : 0;
        soloPlayer.score += pts; catScore += pts; el('solo-nav-score').textContent = soloPlayer.score;

        answersRec.push({ q: soloGameData[activeCat][qIndex].q, user: sel||"TIMEOUT", ans: soloGameData[activeCat][qIndex].ans, pts, correct: isCorrect });
        setTimeout(nextTriviaQ, 1000);
