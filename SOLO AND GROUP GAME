<script>
    // ==========================================
    // TOAST NOTIFICATIONS (Anti-Cheat)
    // ==========================================
    function showToast(message) {
        let container = el('toast-container');
        let toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = `<span>⚠️</span> ${message}`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 3500);
    }

    // ==========================================
    // MENU NAVIGATION & LOCAL STORAGE
    // ==========================================
    function selectMode(mode) {
        hide('main-menu');
        if (mode === 'gm') {
            document.body.className = 'gm-state';
            show('gm-password-screen');
        } else {
            document.body.className = 'solo-state';
            show('solo-app');
            if (soloPlayer.name === "") {
                const savedName = localStorage.getItem('trivia_username');
                if (savedName) {
                    el('solo-player-name').value = savedName;
                    el('returning-user-msg').style.display = 'block';
                }
                show('solo-login-screen');
                hide('solo-top-nav');
                hide('solo-board-screen');
            } else {
                hide('solo-login-screen');
                show('solo-top-nav');
                show('solo-board-screen');
            }
        }
    }

    function verifyGMPassword() {
        if (document.getElementById('gm-password-input').value === 'MEGA') {
            hide('gm-password-screen');
            show('gm-app');
        } else {
            alert("⚠️ INCORRECT PASSWORD. Access Denied.");
