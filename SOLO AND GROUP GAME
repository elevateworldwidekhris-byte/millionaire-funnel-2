    }

    function returnToMenu() {
        if (gameClockInterval) { clearInterval(gameClockInterval); gameClockInterval = null; }
        clearBlitzInterval();
        hide('questions-view'); hide('categories-view'); hide('top-nav-view'); hide('master-sheet-view');
        show('setup-view');

        clearInterval(tInt); clearInterval(memInt); clearInterval(scrInt);
        hide('solo-question-screen'); hide('scr-game-area'); hide('solo-review-screen');
        el('solo-btn-start-mem').style.display = 'block'; el('solo-memory-board').innerHTML = '';
        el('btn-scr-start').style.display = 'block';
        activeCat = ""; memActive = false; scrActive = false;
        hide('solo-board-screen');

        soloPlayer.name = "";
        soloPlayer.score = 0;
        el('solo-player-name').value = "";
        el('solo-nav-score').textContent = "0";

        triviaCompleted = [];
        memCompleted = { easy: false, hard: false };
        scrCompleted = { easy: false, hard: false };

        hide('solo-app'); hide('gm-app'); hide('gm-password-screen');
        show('main-menu');
        document.body.className = 'menu-state';
    }

    const el = id => document.getElementById(id);
    const show = id => { const e = el(id); if(e) e.classList.remove('hidden'); };
    const hide = id => { const e = el(id); if(e) e.classList.add('hidden'); };

    // ==========================================
    // AUDIO SYNTHESIZER (GM MODE)
    // ==========================================
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx;
    function initAudio() { if (!audioCtx) audioCtx = new AudioContext(); if (audioCtx.state === 'suspended') audioCtx.resume(); }
    function playSound(f1, f2, type, d, vol=0.15) {
        initAudio(); const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination); osc.type = type;
        osc.frequency.setValueAtTime(f1, audioCtx.currentTime);
        if(f2) osc.frequency.exponentialRampToValueAtTime(f2, audioCtx.currentTime + d);
        gain.gain.setValueAtTime(vol, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + d);
        osc.start(); osc.stop(audioCtx.currentTime + d);
    }
    function playClick() { playSound(550, 250, 'sine', 0.08, 0.1); }
    function playBloop(i) { playSound(450 + ((i % 6) * 70), 0, 'sine', 0.07, 0.1); }
    function playDing() { playSound(880, 1760, 'sine', 0.6); }
    function playBuzzer() {
        initAudio(); [110, 115].forEach(f => {
            const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
            osc.connect(gain); gain.connect(audioCtx.destination); osc.type = 'sawtooth'; osc.frequency.value = f;
            gain.gain.setValueAtTime(0.15, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
            osc.start(); osc.stop(audioCtx.currentTime + 0.5);
        });
    }
    function playSiren() {
        initAudio();
        const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination); osc.type = 'square';
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime); gain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 1.5);
        osc.frequency.setValueAtTime(400, audioCtx.currentTime);
        osc.frequency.linearRampToValueAtTime(800, audioCtx.currentTime + 0.3);
        osc.frequency.linearRampToValueAtTime(400, audioCtx.currentTime + 0.6);
        osc.frequency.linearRampToValueAtTime(800, audioCtx.currentTime + 0.9);
        osc.frequency.linearRampToValueAtTime(400, audioCtx.currentTime + 1.2);
        osc.start(); osc.stop(audioCtx.currentTime + 1.5);
    }

    // ==========================================
    // GOOGLE SHEETS LEADERBOARD INTEGRATION
    // ==========================================
    const G_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyBZvxiRxHuURCXXHycl1ssjC6h7qBtE1oTSPlEymLXpHYqT57UP1oiuqYdobqH060N/exec";

    function saveScoreToCloud() {
        if (!soloPlayer.name || soloPlayer.score <= 0) return;

        let formData = new FormData();
        formData.append("name", soloPlayer.name);
        formData.append("score", soloPlayer.score);

        fetch(G_SCRIPT_URL, {
            method: "POST",
            body: formData,
            mode: "no-cors"
        }).then(() => console.log("Score synced silently to server."))
            .catch(err => console.error("Sync error:", err));
    }

    function openGlobalLeaderboard() {
        if(typeof playClick === "function") playClick();

        el('main-popup-card').className = "popup-card leaderboard-mode";
