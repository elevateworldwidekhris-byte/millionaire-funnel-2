        el('popup-cat-desc').style.display = "block";
        el('popup-cat-desc').textContent = "Live view from the official Excel Sheet Server.";

        let freshTime = new Date().getTime();

        let html = `
            <div class="iframe-container">
                <iframe src="${G_SCRIPT_URL}?v=${freshTime}" title="Global Leaderboard"></iframe>
            </div>
            <p style="font-size: 0.85rem; color: var(--text-muted);">Scores are saved automatically when you complete a category.</p>
        `;

        el('popup-dynamic-injection-zone').innerHTML = html;

        hide('popup-standard-actions'); hide('popup-intervention-actions'); hide('popup-finalboss-actions'); show('popup-scoreboard-actions');
        show('announcement-popup');
    }

