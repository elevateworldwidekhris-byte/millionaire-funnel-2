            { q: "Sino ang bida sa sikat na pelikulang 'John Wick' na mahilig gumamit ng lapis laban sa mga kaaway?", options: ["Keanu Reeves", "Tom Cruise", "Brad Pitt", "Matt Damon"], ans: "A" }
        ],
        "Science & Tech Breakthroughs": [
            { q: "Ano ang ibig sabihin ng titik 'G' sa mga mobile network standards tulad ng 4G at 5G?", options: ["Global", "Generation", "Gigabyte", "Gateway"], ans: "B" },
